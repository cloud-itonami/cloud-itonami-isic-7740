(ns ipleaseops.sim
  "Demo driver -- `kbb -M:run`. Walks a clean license-record
  logging request through intake -> advise -> govern -> decide ->
  approval -> commit at phase 1 (assisted-logging, always approval),
  then re-runs the same op at phase 3 (supervised-auto, clean + high
  confidence -> auto-commit), then a review-scheduling request,
  royalty-reporting-coordination request (both auto-commit clean at
  phase 3), then an infringement-concern flag (ALWAYS escalates, at
  any phase -- approve, then commit), then HARD-hold scenarios: an
  unregistered license record, a license record registered but not yet
  verified, a proposal whose own `:effect` is not `:propose`, and a
  proposal that has drifted into the permanently-excluded licensing-
  grant-finalization/royalty-rate-determination scope."
  (:require [langgraph.graph :as g]
            [ipleaseops.advisor :as advisor]
            [ipleaseops.store :as store]
            [ipleaseops.operation :as op]))

(defn- exec-op [actor tid request context]
  (g/run* actor {:request request :context context} {:thread-id tid}))

(defn- approve! [actor tid]
  (g/run* actor {:approval {:status :approved :by "ip-licensing-coordinator-1"}} {:thread-id tid :resume? true}))

(defn -main [& _]
  (let [db (store/seed-db)
        coordinator-phase-1 {:actor-id "coord-1" :actor-role :ip-licensing-coordinator :phase 1}
        coordinator-phase-3 {:actor-id "coord-1" :actor-role :ip-licensing-coordinator :phase 3}
        actor (op/build db)]

    (println "== log-license-record license-1 (phase 1, escalates -- human approves) ==")
    (let [r (exec-op actor "t1" {:op :log-license-record :license-id "license-1"
                                  :patch {:licensee "Acme Robotics KK" :usage-report-period "2026-Q2"}} coordinator-phase-1)]
      (println r)
      (println "-- human IP-licensing coordinator approves --")
      (println (approve! actor "t1")))

    (println "\n== log-license-record license-1 (phase 3, clean -- auto-commits) ==")
    (println (exec-op actor "t2" {:op :log-license-record :license-id "license-1"
                                  :patch {:licensee "Northgate Components Inc" :usage-report-period "2026-Q3"}} coordinator-phase-3))

    (println "\n== schedule-review-operation license-1 (phase 3, clean -- auto-commits) ==")
    (println (exec-op actor "t3" {:op :schedule-review-operation :license-id "license-1"
                                  :patch {:review-date "2026-09-18" :scope "compliance-and-usage"}} coordinator-phase-3))

    (println "\n== coordinate-royalty-reporting license-1 (phase 3, clean -- auto-commits) ==")
    (println (exec-op actor "t4" {:op :coordinate-royalty-reporting :license-id "license-1"
                                  :patch {:licensee "Northgate Components Inc" :period "2026-Q3" :reported-units 42000}} coordinator-phase-3))

    (println "\n== flag-infringement-concern license-1 (ALWAYS escalates, even at phase 3) ==")
    (let [r (exec-op actor "t5" {:op :flag-infringement-concern :license-id "license-1"
                                 :patch {:concern "unlicensed use of the connector patent claims observed in a competitor teardown" :confidence 0.9}} coordinator-phase-3)]
      (println r)
      (println "-- human IP-licensing coordinator reviews & approves --")
      (println (approve! actor "t5")))

    (println "\n== log-license-record license-99 (unregistered record -> HARD hold) ==")
    (println (exec-op actor "t6" {:op :log-license-record :license-id "license-99"
                                  :patch {:licensee "Unknown Corp"}} coordinator-phase-3))

    (println "\n== log-license-record license-3 (registered but unverified -> HARD hold) ==")
    (println (exec-op actor "t7" {:op :log-license-record :license-id "license-3"
                                  :patch {:licensee "Late Autumn Franchise Group"}} coordinator-phase-3))

    (println "\n== schedule-review-operation license-1, advisor attempts direct actuation (:effect :commit) -> HARD hold ==")
    (let [actor-direct (op/build db {:advisor (reify advisor/Advisor
                                                (-advise [_ _ req]
                                                  (assoc (advisor/infer nil req) :effect :commit)))})]
      (println (exec-op actor-direct "t8" {:op :schedule-review-operation :license-id "license-1"
                                           :patch {:review-date "2026-10-01"}} coordinator-phase-3)))

    (println "\n== log-license-record license-1, advisor drifts into licensing-grant/royalty-rate-finalization scope -> HARD hold, permanent ==")
    (println (exec-op actor "t9" {:op :log-license-record :license-id "license-1"
                                   :out-of-scope? true
                                   :patch {}} coordinator-phase-3))

    (println "\n== audit ledger ==")
    (doseq [f (store/ledger db)] (println f))

    (println "\n== committed licensing log ==")
    (doseq [r (store/licensing-log db)] (println r))))
